{
  "name": "@craft-cross-cms/content-references",
  "version": "0.0.0",
  "description": "Resolve reference fields of Craft Cross CMS (xcms) contents into the referenced contents",
  "license": "Apache-2.0",
  "author": "PLAID, Inc.",
  "repository": {
    "type": "git",
    "url": "https://github.com/plaidev/craft-cross-cms.git",
    "directory": "packages/content-references"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "catalog:",
    "tsup": "catalog:",
    "vitest": "catalog:"
  }
}
